from sklearn.svm import SVR
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn import datasets
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score


df=datasets.load_diabetes(as_frame=True).frame 
df.head()
# df.isnull().sum()
df.shape


x=df.drop("target",axis=1)
y=df['target']

x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.3,random_state=42)




x.head()
y.head()

# Standard scaling  --->> Here we scaling y

y_scaler=StandardScaler()

y_train_scaled=y_scaler.fit_transform(y_train.values.reshape(-1,1)).ravel()
y_test_scaled=y_scaler.transform(y_test.values.reshape(-1,1)).ravel()



# model

model= SVR()
model.fit(x_train,y_train_scaled)


y_pred_test_scaled=model.predict(x_test)
y_pred_train_scaled=model.predict(x_train)


# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))



# linear kernel

model= SVR(kernel="linear")
model.fit(x_train,y_train_scaled)

y_pred_test_scaled=model.predict(x_test)
y_pred_train_scaled=model.predict(x_train)

# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))



# polynomial kernel

model= SVR(kernel="poly")
model.fit(x_train,y_train_scaled)

y_pred_test_scaled=model.predict(x_test)
y_pred_train_scaled=model.predict(x_train)

# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))



#sigmoid kernel

model= SVR(kernel="sigmoid")
model.fit(x_train,y_train_scaled)

y_pred_test_scaled=model.predict(x_test)
y_pred_train_scaled=model.predict(x_train)

# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))






from sklearn.model_selection import GridSearchCV


param_grid={
    "kernel":["linear","poly","rbf","sigmoid"],
    "C" : [1,2,3,3.2,3.3,3.4,3.5,4,4.5,5,10,100],
    "epsilon" :[0.001,0.01,0.1,1,0.2,0.3,0.5,5]
}

svr=SVR()

grid_search=GridSearchCV(svr, param_grid, scoring="r2", cv=5)

grid_search.fit(x_train,y_train_scaled)


print("best parameters -->",grid_search.best_params_)


# best model
best_model=SVR(C=10, epsilon=0.1, kernel="linear")

best_model.fit(x_train,y_train_scaled)



y_pred_test_scaled=best_model.predict(x_test)
y_pred_train_scaled=best_model.predict(x_train)

# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))






# linearSVR

from sklearn.svm import LinearSVR

model=LinearSVR(max_iter=10000, C=10, epsilon=0.1)

model.fit(x_train,y_train_scaled)


y_pred_test_scaled=model.predict(x_test)
y_pred_train_scaled=model.predict(x_train)

# evaluation 

print("for test r2_score is ",r2_score(y_test_scaled,y_pred_test_scaled))
print("for train r2_score is ",r2_score(y_train_scaled,y_pred_train_scaled))




